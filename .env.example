# =============================================================================
# Raveena Sarees — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your real credentials.
# NEVER commit .env.local or any file containing real secrets to git.
# =============================================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
# These are public and safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Server-only — NEVER expose to client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Key ID is public (used in Razorpay Checkout on the frontend).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Server-only — NEVER expose to client-side code.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Email Provider (Server-only) ───────────────────────────────────────────
# Abstracted — swap provider by changing these values.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=orders@ravinasarees.in
EMAIL_FROM_NAME=Raveena Sarees

# ─── Shipping Provider (Server-only) ────────────────────────────────────────
SHIPPING_PROVIDER=manual
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# DELHIVERY_API_KEY=

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
