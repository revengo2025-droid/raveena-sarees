# =============================================================================
# Raveena Sarees — Environment Variables
# =============================================================================
# Copy this file to .env.local (local) and set the same keys in your hosting provider (production).
# NEVER commit .env.local or any file containing real secrets to git.
# Only variables starting with NEXT_PUBLIC_ reach the browser. Never prefix a secret with NEXT_PUBLIC_.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
# Production must be https://www.raveenasarees.com (used for canonical URLs, sitemap, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Server-only — bypasses RLS. NEVER expose to client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Key ID is public (used by Razorpay Checkout in the browser).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
# Server-only
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Razorpay Dashboard > Webhooks: URL https://www.raveenasarees.com/api/webhooks/razorpay
# Events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ─── Email: Resend (server-only) ─────────────────────────────────────────────
# API key from https://resend.com/api-keys (a "Sending access" key is enough).
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Must be on a domain verified in Resend (e.g. verify raveenasarees.com, then use orders@raveenasarees.com).
# Gmail addresses cannot be used as the sender.
RESEND_FROM_EMAIL=orders@raveenasarees.com
RESEND_FROM_NAME=Raveena Sarees
# Customer replies go here
RESEND_REPLY_TO=raveenasarees22@gmail.com

# ─── Shipping: Shiprocket (server-only) ──────────────────────────────────────
# Use an API user (Shiprocket > Settings > API > Configure > Create API User), not your panel login.
SHIPROCKET_EMAIL=api-user@example.com
SHIPROCKET_PASSWORD=your-shiprocket-api-user-password
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
# Exact nickname of the pickup address in Shiprocket > Settings > Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: Shiprocket channel id for the custom "Raveena" channel
SHIPROCKET_CHANNEL_ID=
# Token you type into Shiprocket > Settings > API > Webhooks (sent back to us as the x-api-key header).
# Webhook URL: https://www.raveenasarees.com/api/webhooks/shipping   (use a long random value)
SHIPROCKET_WEBHOOK_TOKEN=
# Automation (defaults: true). Assigning an AWB debits the Shiprocket wallet.
SHIPROCKET_AUTO_ASSIGN_AWB=true
SHIPROCKET_AUTO_PICKUP=true
# Optional: force one courier id; leave empty to use Shiprocket's recommended courier
SHIPROCKET_COURIER_ID=
# Package defaults per saree (weight scales with quantity)
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=30
SHIPROCKET_DEFAULT_BREADTH_CM=25
SHIPROCKET_DEFAULT_HEIGHT_CM=5

# ─── Background retries (server-only) ────────────────────────────────────────
# Protects GET /api/cron/maintenance (retries failed emails, Shiprocket syncs, webhook events).
# Call it every 5–15 minutes with header "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it automatically).
CRON_SECRET=generate-a-long-random-string

# ─── Business details shown on legal pages (never invented; leave blank until you have them) ──
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=

# ─── Contact details shown on the site (public: NEXT_PUBLIC_ values are visible in the browser) ──
# Official business email shown in the footer, contact page, policies, emails and structured data.
# If unset, the site falls back to the mailbox that already existed in this project.
NEXT_PUBLIC_BUSINESS_CONTACT_EMAIL=
# Optional. Both default to the contact email above when blank.
NEXT_PUBLIC_BUSINESS_SUPPORT_EMAIL=
NEXT_PUBLIC_BUSINESS_GRIEVANCE_EMAIL=
# Phone / WhatsApp shown on the site, e.g. "+91 77807 56009". Blank keeps the current number.
NEXT_PUBLIC_BUSINESS_PHONE=

# ─── Private inbox for internal alerts (server-only) ─────────────────────────
# Receives "new contact message", "new support query" and "customer replied" emails.
# Comma separated for several people. Blank falls back to the support email.
CONTACT_NOTIFY_EMAIL=

# ─── Security (server-only) ──────────────────────────────────────────────────
# Optional first-admin bootstrap: comma separated, CONFIRMED emails that are given the admin role the first time
# they sign in and have no profile yet. Leave blank once your admin profile exists (see migration 005).
ADMIN_BOOTSTRAP_EMAILS=
# Secret used to hash IP addresses for abuse rate limiting (the raw IP is never stored). Any long random string.
IP_HASH_SALT=
# Mail provider adapter. Only "resend" is implemented; add another in src/lib/services/email/index.ts to switch.
EMAIL_PROVIDER=resend
